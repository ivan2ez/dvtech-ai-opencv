# ===========================================
# DVTech AI Backend - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development

# Database (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=dvtech_ai
DB_NAME_TEST=dvtech_ai_test

# JWT Authentication
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=24h

# Internal cron secret — protects the internal maintenance endpoints
# (/api/internal/expire-reschedules) invoked by the scheduler. On Vercel, set
# CRON_SECRET to the SAME value; Vercel Cron sends it as `Authorization: Bearer <secret>`.
INTERNAL_CRON_SECRET=your_internal_cron_secret_here
CRON_SECRET=your_internal_cron_secret_here

# OpenAI API (for image analysis & recommendations)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Google Gemini API (for AC troubleshooting)
GEMINI_API_KEY=your_gemini_api_key_here

# AI Microservice (Python/FastAPI)
AI_SERVICE_URL=http://localhost:8000

# CORS
FRONTEND_URL=http://localhost:5173

# Email delivery (Resend) — used for the Gmail OTP verification codes and the
# reschedule notifications sent to customers.
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
# Must be an address on a domain you've verified in Resend. The shared
# onboarding@resend.dev sender only delivers to your own Resend account email.
RESEND_FROM_EMAIL=DVTech <onboarding@resend.dev>

# Base URL used to build the action links inside outbound emails
APP_BASE_URL=http://localhost:5173
